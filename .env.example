# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# NVIDIA NIM API Key (from build.nvidia.com) — used for the LLM
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# NIM LLM Model (default: llama 3.1 70b)
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct

# Groq API Key (from console.groq.com) — used for Whisper ASR.
# NIM cloud doesn't host Whisper, so ASR is offloaded to Groq (free tier).
GROQ_API_KEY=your_groq_api_key_here
GROQ_ASR_MODEL=whisper-large-v3-turbo

# SQLite DB path
DB_PATH=p33c1.db

# Restrict bot to specific Discord server(s). Comma-separated guild IDs.
# Leave empty to allow any server (NOT recommended for personal personas).
ALLOWED_GUILD_IDS=

# Persona — overrides defaults in persona.py.
# Defaults are tuned for RATTUS (Romanian, terse, mean, ratty).
PERSONA_NAME=RATTUS
# PERSONA_TRAITS=
# PERSONA_NOTES=

# TTS voice (edge-tts). Romanian male voices: ro-RO-EmilNeural
# Other options: en-GB-RyanNeural, en-US-GuyNeural, etc.
TTS_VOICE=ro-RO-EmilNeural
TTS_RATE=+40%
TTS_PITCH=-5Hz
